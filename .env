# PocketBase URL - served via Traefik on pb.frasi.info
VITE_POCKETBASE_URL=https://pb.frasi.info

# Metti a "true" solo quando pb.frasi.info ha un provider SMTP reale attivo
# (Settings > Mail su PocketBase). Finché resta false, il reset password
# mostra un avviso invece del messaggio "controlla la tua email".
VITE_SMTP_CONFIGURED=false
